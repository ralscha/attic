			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>

		<operation name="getCancelledAndInactiveAhvvn">
			<soap:operation soapAction="http://soap.upi.admin.ch"/>
			<input>
				<soap:body use="literal"/>
			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>

		<operation name="getSource">
			<soap:operation soapAction="http://soap.upi.admin.ch"/>
			<input>
				<soap:body use="literal"/>
			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>

		<operation name="listOfSearchPerson">
			<soap:operation soapAction="http://soap.upi.admin.ch"/>
			<input>
				<soap:body use="literal"/>
			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>

		<operation name="listOfGetInfoPerson">
			<soap:operation soapAction="http://soap.upi.admin.ch"/>
			<input>
				<soap:body use="literal"/>
			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>

		<operation name="listOfGetAhvvn">
			<soap:operation soapAction="http://soap.upi.admin.ch"/>
			<input>
				<soap:body use="literal"/>
			</input>
			<output>
				<soap:body use="literal"/>
			</output>
		</operation>		
	</binding>

	<service name="UPIQueryService">
		<port name="UPIQueryServicePort" binding="upi-ws:UPIQueryServiceBinding">
			<soap:address location="http://ws.zas.admin.ch/soap?Service=UPIQueryService"/>
		</port>
	</service>
</definitions>
